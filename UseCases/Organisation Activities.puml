@startuml
left to right direction

actor User

database "World Database" as DB

rectangle "World Population Reporting System" {

usecase UC1 as "Generate Country Population Report"
usecase UC2 as "Generate Top N Country Report"
usecase UC3 as "Generate City Population Report"
usecase UC4 as "Generate Top N City Report"
usecase UC5 as "Generate Capital City Report"
usecase UC6 as "Generate Population Summary Report"
usecase UC7 as "Generate Language Report"
usecase UC8 as "Search and Filter Reports"

UC1 --> DB
UC2 --> DB
UC3 --> DB
UC4 --> DB
UC5 --> DB
UC6 --> DB
UC7 --> DB

UC1 .> UC8 : <<include>>
UC2 .> UC8 : <<include>>
UC3 .> UC8 : <<include>>
UC4 .> UC8 : <<include>>
UC5 .> UC8 : <<include>>
UC6 .> UC8 : <<include>>

}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

@enduml